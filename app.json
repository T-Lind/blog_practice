{
  "name": "blog-practice",
  "description": "CSCE 431 blog practice",
  "stack": "heroku-24",
  "scripts": {
    "postdeploy": "bundle exec rails db:migrate && bundle exec rails db:seed"
  },
  "addons": [
    "heroku-postgresql:essential-0"
  ],
  "env": {
    "RAILS_ENV": {
      "required": true,
      "value": "production"
    },
    "RAILS_SERVE_STATIC_FILES": {
      "required": true,
      "value": "enabled"
    },
    "RAILS_LOG_TO_STDOUT": {
      "required": true,
      "value": "enabled"
    },
    "SECRET_KEY_BASE": {
      "generator": "secret"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
